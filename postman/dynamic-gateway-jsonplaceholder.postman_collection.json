        {
          "name": "Rate limit: 3 a cada 10s por X-Api-Key",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"apiKey\", \"postman-\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"a primeira passa, com os headers RateLimit-*\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.headers.get(\"RateLimit-Limit\")).to.eql(\"3\");",
                  "    pm.expect(pm.response.headers.get(\"RateLimit-Policy\")).to.eql(\"3;w=10\");",
                  "});",
                  "// Mais 8 chamadas com a mesma chave: até 3 passam em cada réplica do gateway, e uma",
                  "// vaga volta a cada 3,3s; com 1 ou 2 réplicas, pelo menos uma das 9 recebe 429.",
                  "const key = pm.collectionVariables.get(\"apiKey\");",
                  "const target = pm.variables.get(\"baseUrl\") + \"/jp/limitado/posts/1\";",
                  "const statuses = [pm.response.code];",
                  "function next(left) {",
                  "    if (left === 0) {",
                  "        pm.test(\"o excesso recebe 429: \" + statuses.join(\" \"), () => pm.expect(statuses).to.include(429));",
                  "        return;",
                  "    }",
                  "    pm.sendRequest({ url: target, method: \"GET\", header: { \"X-Api-Key\": key } }, (err, res) => {",
                  "        statuses.push(err ? 0 : res.code);",
                  "        if (res && res.code === 429) {",
                  "            pm.test(\"o 429 traz Retry-After e diz o motivo\", () => {",
                  "                pm.expect(res.headers.get(\"Retry-After\")).to.match(/^\\d+$/);",
                  "                pm.expect(res.json().error).to.eql(\"Too Many Requests\");",
                  "                pm.expect(res.json().message).to.include(\"Rate limit of this route reached\");",
                  "            });",
                  "        }",
                  "        next(left - 1);",
                  "    });",
                  "}",
                  "next(8);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/jp/limitado/posts/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jp",
                "limitado",
                "posts",
                "1"
              ]
            },
            "description": "Cada `X-Api-Key` tem 3 requisições a cada 10 segundos. O script de teste faz mais 8 chamadas com a mesma chave e confere o 429. A chave muda a cada execução, para o orçamento começar cheio."
          },
          "response": []
        },
        {
          "name": "Throttling: 1 por vez, 1 na fila",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"sozinha, a chamada passa\", () => pm.response.to.have.status(200));",
                  "// 7 chamadas ao mesmo tempo: cada réplica deixa 1 rodando e 1 na fila, e recusa o resto com 503.",
                  "const target = pm.variables.get(\"baseUrl\") + \"/jp/lento/comments\";",
                  "const statuses = [];",
                  "for (let i = 0; i < 7; i++) {",
                  "    pm.sendRequest({ url: target, method: \"GET\" }, (err, res) => {",
                  "        statuses.push(err ? 0 : res.code);",
                  "        if (res && res.code === 503) {",
                  "            pm.test(\"o 503 diz o motivo\", () => pm.expect(res.json().error).to.eql(\"Service Unavailable\"));",
                  "        }",
                  "        if (statuses.length === 7) {",
                  "            pm.test(\"ao mesmo tempo, o excesso recebe 503: \" + statuses.sort().join(\" \"), () => {",
                  "                pm.expect(statuses).to.include(200);",
                  "                pm.expect(statuses).to.include(503);",
                  "            });",
                  "        }",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/jp/lento/comments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jp",
                "lento",
                "comments"
              ]
            },
            "description": "Só uma requisição roda por vez, e uma espera na fila por até 5 segundos. O script de teste dispara 7 chamadas juntas e confere os 503."
          },
          "response": []
        },
