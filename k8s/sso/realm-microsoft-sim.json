{
  "realm": "microsoft-sim",
  "displayName": "Microsoft (simulado)",
  "enabled": true,
  "sslRequired": "none",
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "tools-broker",
      "name": "Login com Microsoft do realm tools",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${MICROSOFT_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${GATEWAY_PUBLIC_BASE_URL}/auth/realms/tools/broker/microsoft/endpoint"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
